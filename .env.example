# ── Flatkey (required) ─────────────────────────────────────────────
# Mochi runs on Flatkey: one key for every model she needs (chat, vision,
# search, memory). Official models. Better prices.
#  • Save money: mainstream models are at least 20% below official pricing,
#    and failed calls cost $0.
#  • Save time: one key, one balance, one bill instead of an account per provider.
# You can also skip this and bind the key in the dashboard (Flatkey API key page).
# Create your key (sign up first if needed):
# https://console.flatkey.ai/keys?utm_source=mochi_bot&utm_medium=local_deploy&utm_campaign=mochi&utm_content=env_example
FLATKEY_API_KEY=

# ── Dashboard ──────────────────────────────────────────────────────
PORT=3000
# Dashboard password. Leave empty: the first time you open http://localhost:3000/dashboard it asks
# you to choose one and saves it here scrambled (nobody can read it back). Forgot it? Empty this line and restart Mochi.
ADMIN_TOKEN=
# Public URL of this server (used by the web widget snippet)
PUBLIC_URL=http://localhost:3000
# Google Analytics 4 measurement id for the dashboard (leave empty to stay untracked).
# Served through /ga.js, so forks never report into someone else's property.
GA_MEASUREMENT_ID=

# Behind a cloud ingress or reverse proxy on another machine (Sealos, Railway, Render, Nginx on a
# separate host), set to 1 so rate limits see each visitor's real IP. Default: trust only localhost.
# TRUST_PROXY=1

# ── Channels (optional) ───────────────────────────────────────────
# Connect Discord / Telegram / Slack / QQ per bot in the dashboard (bot → Channels).
# Tokens set here still work and apply to your first bot.
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# QQ official bot (q.qq.com → 开发管理): AppID + AppSecret
QQ_APP_ID=
QQ_APP_SECRET=

# ── Network (optional) ────────────────────────────────────────────
# Node ignores your computer's proxy settings. If Telegram / Flatkey open in your browser but
# Mochi says it "couldn't reach" them, point this at your proxy app's HTTP port, e.g. Clash:
# HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=

# Where Mochi keeps bots, memory, knowledge and secrets
DATA_DIR=./data

# ── Database (optional) ───────────────────────────────────────────
# Empty: everything lives in DATA_DIR (a SQLite file + a few JSON files). Nothing to install.
# A PostgreSQL address: everything lives in that database instead, so Mochi keeps nothing on its own
# disk (good for hosts without a volume, or several copies of Mochi behind one database).
# Move your data either way with:  npm run db -- copy --to "postgres://…"   /   --to local
# DATABASE_URL=postgres://user:password@host:5432/mochi
DATABASE_URL=
